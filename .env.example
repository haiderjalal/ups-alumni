# Copy to .env.local (development) or set these in your host's secret store.
# Never commit real values. Every variable below is validated in src/lib/env.ts.

# ---- Application -----------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
APP_TIMEZONE=Asia/Karachi

# ---- PostgreSQL ------------------------------------------------------------
# Local Docker Compose database (see docker-compose.yml). Change the password for any shared environment.
DATABASE_URL=postgresql://ups_app:ups_local_only@localhost:5432/ups_alumni?schema=public

# ---- Authentication (Better Auth) -------------------------------------------
BETTER_AUTH_URL=http://localhost:3000
# At least 32 random characters, e.g. `openssl rand -base64 32`. Required in every environment.
BETTER_AUTH_SECRET=

# ---- Transactional email ------------------------------------------------------
# dev-sink writes messages to ./.dev-mail (development only). smtp uses the settings below.
EMAIL_DRIVER=dev-sink
EMAIL_FROM="UPS Alumni Network <no-reply@example.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# ---- Private object storage (receipts, school documents, private uploads) ----
# local writes under STORAGE_LOCAL_DIR (development only). s3 targets any S3-compatible service, such as MinIO.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.local-storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=ups-alumni-private
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
