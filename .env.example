# Copy to .env.local (development) or set these in your host's secret store.
# Never commit real values. Every variable below is validated in src/lib/env.ts.

# ---- Application -----------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
APP_TIMEZONE=Asia/Karachi

# ---- PostgreSQL ------------------------------------------------------------
# Local Docker Compose database (see docker-compose.yml). Change the password for any shared environment.
DATABASE_URL=postgresql://ups_app:ups_local_only@localhost:5432/ups_alumni?schema=public

# ---- Authentication (Better Auth) -------------------------------------------
BETTER_AUTH_URL=http://localhost:3000
# At least 32 random characters, e.g. `openssl rand -base64 32`. Required in every environment.
BETTER_AUTH_SECRET=

# ---- Transactional email (Resend) -------------------------------------------
# dev-sink writes messages to ./.dev-mail (development only). resend sends through the Resend API.
# RESEND_API_KEY is a server-only secret. EMAIL_FROM must use a domain verified in Resend.
EMAIL_DRIVER=dev-sink
EMAIL_FROM="UPS Alumni Network <no-reply@example.com>"
RESEND_API_KEY=

# ---- Private object storage (Supabase Storage) ------------------------------
# local writes under STORAGE_LOCAL_DIR (development only). supabase stores files in a PRIVATE bucket.
# SUPABASE_SERVICE_ROLE_KEY is a server-only secret: never prefix it with NEXT_PUBLIC_.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.local-storage
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=ups-alumni-private
